---
import { seqSetsAreEnabled } from '../../config';
import { serverBackendApi } from '../../services/serverApi.ts';

if (!seqSetsAreEnabled()) {
    return Astro.rewrite('/404');
}

const { seqSetId = '' } = Astro.params;

const versionsResult = await serverBackendApi().getSeqSetVersions({ seqSetId });

if (versionsResult.isOk() && versionsResult.value.length > 0) {
    const latestVersion = Math.max(...versionsResult.value.map((s) => s.seqSetVersion));
    return Astro.redirect(`/seqsets/${seqSetId}.${latestVersion}`);
}

return Astro.rewrite('/404');
---
