---
import { cleanOrganism } from '../../../../../components/Navigation/cleanOrganism';
import { RevisionDiffPage } from '../../../../../components/ReviewPage/RevisionDiffPage';
import SubmissionPageWrapper from '../../../../../components/Submission/SubmissionPageWrapper.astro';
import { getReferenceGenomes, getRuntimeConfig, getSchema } from '../../../../../config';
import { parseAccessionVersionFromString } from '../../../../../utils/extractAccessionVersion';
import { getAccessToken } from '../../../../../utils/getAccessToken';
import { getGroupsAndCurrentGroup } from '../../../../../utils/submissionPages';

const { organism } = cleanOrganism(Astro.params.organism);
const { accession, version } = parseAccessionVersionFromString(Astro.params.accessionVersion!);
if (!organism || !accession || version === undefined || !Number.isSafeInteger(version) || version < 2) {
    return new Response(undefined, { status: 404 });
}

const groupsResult = await getGroupsAndCurrentGroup(Astro.params, Astro.locals.session);
// Shared formatting needs the full metadata schema on the client.
const metadata = getSchema(organism.key).metadata;
Astro.response.headers.append('Cache-Control', 'no-cache, no-store, must-revalidate');
---

<SubmissionPageWrapper
    title={`Metadata changes for ${accession}.${version}`}
    groupsResult={groupsResult}
    disablePageTitle
>
    {
        groupsResult.match(
            ({ currentGroup }) => (
                <RevisionDiffPage
                    accessionVersion={{ accession, version }}
                    groupId={currentGroup.groupId}
                    metadata={metadata}
                    organism={organism.key}
                    clientConfig={getRuntimeConfig().public}
                    accessToken={getAccessToken(Astro.locals.session)!}
                    referenceGenomesInfo={getReferenceGenomes(organism.key)}
                    client:load
                />
            ),
            () => undefined,
        )
    }
</SubmissionPageWrapper>
