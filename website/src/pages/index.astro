---
import Faq from '../components/IndexPage/FAQ.mdx';
import OrganismCardGrid from '../components/IndexPage/OrganismCardGrid.astro';
import WelcomeMessage from '../components/IndexPage/WelcomeMessage.astro';
import { getOrganismStatisticsMap } from '../components/IndexPage/getOrganismStatistics';
import { getConfiguredOrganisms, getRuntimeConfig, getWebsiteConfig } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAccessToken } from '../utils/getAccessToken';
const websiteConfig = getWebsiteConfig();
const { name: websiteName, welcomeMessageHTML } = websiteConfig;
import '../styles/mdcontainer.css';

const numberDaysAgoStatistics = 30;
const accessToken = getAccessToken(Astro.locals.session);
// The homepage stays public; without a token, LAPIS would reject the statistics requests.
const showStatistics = accessToken !== undefined || getRuntimeConfig().public.requireAuthenticationForData !== true;
const organismStatisticsMap = showStatistics
    ? await getOrganismStatisticsMap(
          getConfiguredOrganisms().map((organism) => organism.key),
          numberDaysAgoStatistics,
          accessToken,
      )
    : new Map();
---

<BaseLayout title='Home'>
    <div class='max-w-6xl mx-auto'>
        <WelcomeMessage websiteName={websiteName} welcomeMessageHTML={welcomeMessageHTML} />

        <div class='mt-8 mb-4'>
            <OrganismCardGrid
                organisms={getConfiguredOrganisms()}
                organismStatisticsMap={organismStatisticsMap}
                numberDaysAgoStatistics={numberDaysAgoStatistics}
            />
        </div>
        <div class='mdContainer'>
            <Faq />
        </div>
    </div>
</BaseLayout>
