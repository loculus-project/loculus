---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title='Not found'>
    <div class='max-w-xl mx-auto py-16 sm:py-24 text-center'>
        <p class='text-sm font-semibold uppercase tracking-wide text-primary-600'>404</p>
        <h1 class='mt-2 text-3xl font-semibold text-gray-900 sm:text-4xl'>Page not found</h1>
        <p class='mt-4 text-gray-600'>The page you are looking for does not exist.</p>
        <a
            href='/'
            class='mt-8 inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-primary-700 hover:text-white hover:no-underline!'
        >
            Go to the homepage
        </a>
    </div>
</BaseLayout>
